{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "outDir": "dist",
    // The root brand config sits outside src/; esbuild bundles it, tsc only checks.
    "rootDir": "../..",
    "types": ["node"],
    "paths": {
      "@brand/*": ["../../src/brand/*"]
    }
  },
  "include": ["src", "../../src/brand/brand.config.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "../../lib/db"
    },
    {
      "path": "../../lib/api-zod"
    },
    {
      "path": "../../lib/integrations-anthropic-ai"
    }
  ]
}
